{
  "name": "canaryau/laravel-encryption",
  "description": "A package to easily encrypt & decrypt model fields in Laravel using OpenSSL.",
  "keywords": [
    "canaryau",
    "laravel-encryption"
  ],
  "homepage": "https://github.com/canaryau/laravel-encryption",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Joel Male",
      "email": "joel@joelmale.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1|^8.2|^8.3|^8.4",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "nesbot/carbon": "^2.0|^3.0",
    "ext-json": "*"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "nunomaduro/collision": "^8.0",
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-arch": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Canaryau\\LaravelEncryption\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage",
    "format": "vendor/bin/pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Canaryau\\LaravelEncryption\\LaravelEncryptionServiceProvider"
      ],
      "aliases": {
        "LaravelEncryption": "Canaryau\\LaravelEncryption\\LaravelEncryptionFacade"
      }
    }
  }
}
